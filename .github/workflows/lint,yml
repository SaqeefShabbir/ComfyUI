name: Python Linting

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]

jobs:
  lint:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'
      
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install ruff pylint black
      
      - name: Run Ruff (Linting)
        run: |
          # Check only your code, exclude third-party custom nodes
          ruff check . --exclude "custom_nodes/*,comfyui_env/*,models/*,output/*,user/*" --exit-zero
      
      - name: Run Pylint (Optional)
        run: |
          # Only run pylint on your code
          pylint comfy/ app/ api_server/ --fail-under=7.0 || true
      
      - name: Check formatting
        run: |
          black --check . --exclude "custom_nodes/|comfyui_env/|models/|output/|user/" || true